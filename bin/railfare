#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
UV_BIN="/pi/uv/tool/bin/uv"
PROJECT_DIR="$ROOT_DIR/tools/railfare"
SCRIPT="$PROJECT_DIR/railfare.py"

if [[ ! -x "$UV_BIN" ]]; then
  printf '错误：找不到受控 uv：%s\n' "$UV_BIN" >&2
  exit 1
fi

exec "$UV_BIN" run --locked --project "$PROJECT_DIR" python "$SCRIPT" "$@"
