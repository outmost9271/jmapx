#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""JMAP 客户端工具。

子命令：
  total        获取邮件总数（含垃圾箱）
  emails       列出所有邮件（含垃圾箱），支持过滤
  detail       按 ids 查询邮件详情（含正文、附件列表）
  attachments  按 ids 查询附件列表，可筛选并下载
  download     按 blobId 下载附件

仅依赖 Python 3 标准库。
"""

import argparse
import base64
import fnmatch
import json
import os
import re
import shutil
import stat
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass
from datetime import datetime, timedelta, timezone
from threading import Lock

DEFAULT_CREDS_FILE = "jmapx_creds.json"
ENV_FIELDS = {
    "server": "JMAP_SERVER",
    "username": "JMAP_USERNAME",
    "password": "JMAP_PASSWORD",
}
REQUIRED_FIELDS = tuple(ENV_FIELDS)
CORE_CAPABILITY = "urn:ietf:params:jmap:core"
MAIL_CAPABILITY = "urn:ietf:params:jmap:mail"
USING = [CORE_CAPABILITY, MAIL_CAPABILITY]
HTTP_TIMEOUT = 30
COPY_BUFFER_SIZE = 64 * 1024
QUERY_PAGE_SIZE = 5000
DEFAULT_MAX_OBJECTS = 500
DEFAULT_MAX_CALLS = 16

EMAIL_PROPERTIES = [
    "id", "subject", "from", "to", "receivedAt", "sentAt", "size", "preview",
    "mailboxIds", "keywords", "hasAttachment",
]
DETAIL_PROPERTIES = EMAIL_PROPERTIES + [
    "textBody", "htmlBody", "bodyValues", "attachments",
]
ATTACHMENT_PROPERTIES = ["id", "subject", "from", "to", "attachments"]
MAILBOX_PROPERTIES = ["id", "name", "role", "totalEmails", "unreadEmails"]

_DESTINATION_LOCK = Lock()


class JmapxError(Exception):
    """可向用户展示的预期错误。"""


@dataclass(frozen=True)
class JmapContext:
    """一次命令执行所需的认证、Session 与能力信息。"""

    username: str
    password: str
    session: dict
    account_id: str
    api_url: str
    max_objects: int
    max_calls: int
    debug: bool = False

    @property
    def download_url(self):
        return self.session.get("downloadUrl")


def fail(message):
    raise JmapxError(message)


def debug_log(enabled, message):
    if enabled:
        print(f"[调试] {message}", file=sys.stderr)


def print_json(data, pretty=False):
    print(json.dumps(data, ensure_ascii=False, indent=4 if pretty else None))


def compact_json(data):
    return json.dumps(data, ensure_ascii=False)


def split_csv(value):
    return [item.strip() for item in (value or "").split(",") if item.strip()]


def unique_in_order(items):
    seen = set()
    return [item for item in items if not (item in seen or seen.add(item))]


def unique_jobs_by_blob_id(jobs):
    seen = set()
    return [job for job in jobs if not (job[0] in seen or seen.add(job[0]))]


def parse_ids(value, debug=False, report_duplicates=False):
    ids = split_csv(value)
    if not ids:
        fail("--ids 不能为空，请提供逗号分隔的邮件 id 列表")
    unique_ids = unique_in_order(ids)
    if report_duplicates and debug and len(unique_ids) != len(ids):
        debug_log(True, f"输入 {len(ids)} 个 id，去重后 {len(unique_ids)} 个")
    return unique_ids


def parse_datetime_arg(value, is_end, param_name):
    """解析时间参数并输出秒级 UTC RFC 3339 字符串。"""
    text = value.strip().replace(" ", "T")
    try:
        if re.fullmatch(r"\d{4}-\d{2}-\d{2}", text):
            parsed = datetime.strptime(text, "%Y-%m-%d")
            if is_end:
                parsed += timedelta(days=1)
        else:
            parsed = datetime.fromisoformat(text)
    except ValueError:
        fail(
            f"参数 {param_name} 日期格式无效: {value}"
            "（支持 YYYY-MM-DD 或 YYYY-MM-DDTHH:MM:SS，可带时区 Z/±HH:MM）"
        )
    if parsed.tzinfo is None:
        parsed = parsed.astimezone()
    return parsed.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_query_addr(text):
    """解析 Name <email> / email / Name 三种精确匹配输入。"""
    match = re.search(r"<([^<>]+)>", text)
    if match:
        return {
            "email": match.group(1).strip(),
            "name": text[:match.start()].strip() or None,
        }
    if "@" in text:
        return {"email": text.strip(), "name": None}
    return {"email": None, "name": text.strip() or None}


def address_matches(address, query):
    if query["email"] and address.get("email"):
        return address["email"].lower() == query["email"].lower()
    if query["name"] and address.get("name"):
        return address["name"] == query["name"]
    return False


def email_matches(email, field, query):
    return any(address_matches(address, query) for address in email.get(field) or [])


def credentials_from_env():
    values = {field: os.environ.get(env_name) for field, env_name in ENV_FIELDS.items()}
    if all(values.values()):
        names = "/".join(ENV_FIELDS.values())
        return values, f"环境变量 {names}"
    return None, None


def credentials_from_file(path):
    try:
        file_stat = os.stat(path)
    except FileNotFoundError:
        fail(f"身份配置文件不存在: {path}")

    if os.name != "nt":
        mode = stat.S_IMODE(file_stat.st_mode)
        if mode != 0o600:
            fail(
                f"身份配置文件权限必须为 600，当前为 {oct(mode)}，已拒绝执行: {path}"
                f"（请先执行: chmod 600 {path}）"
            )

    try:
        with open(path, encoding="utf-8") as file:
            credentials = json.load(file)
    except json.JSONDecodeError as error:
        fail(f"身份配置文件不是合法 JSON: {path}（{error}）")
    except OSError as error:
        fail(f"无法读取身份配置文件: {path}（{error}）")

    if not isinstance(credentials, dict):
        fail(f"身份配置文件格式错误，应为 JSON 对象: {path}")
    missing = [field for field in REQUIRED_FIELDS if not credentials.get(field)]
    if missing:
        fail(f"身份配置文件缺少必填字段: {', '.join(missing)}（文件: {path}）")
    return credentials, f"身份配置文件 {path}"


def resolve_credentials(creds_file):
    credentials, source = credentials_from_env()
    if credentials:
        return credentials, source

    configured = [name for name in ENV_FIELDS.values() if os.environ.get(name)]
    if configured:
        print(
            f"提示: 环境变量 {', '.join(configured)} 已设置但不完整，回退读取身份配置文件",
            file=sys.stderr,
        )
    path = creds_file or os.path.join(
        os.path.dirname(os.path.abspath(__file__)), DEFAULT_CREDS_FILE
    )
    return credentials_from_file(path)


def normalize_server(server):
    if not server.startswith(("http://", "https://")):
        server = "https://" + server
    return server.rstrip("/")


def basic_auth_header(username, password):
    token = base64.b64encode(f"{username}:{password}".encode("utf-8")).decode("ascii")
    return f"Basic {token}"


def http_error_message(error):
    if error.code == 401:
        return "认证失败（HTTP 401），请检查用户名/密码"
    if error.code == 429:
        return "请求被限流（HTTP 429），请稍后重试"
    try:
        detail = error.read().decode("utf-8", "replace")[:200]
    except OSError:
        detail = ""
    return f"HTTP {error.code}: {detail or error.reason}"


def open_request(request):
    try:
        return urllib.request.urlopen(request, timeout=HTTP_TIMEOUT)
    except urllib.error.HTTPError as error:
        raise JmapxError(http_error_message(error)) from error
    except urllib.error.URLError as error:
        raise JmapxError(f"网络错误: {error.reason}") from error


def http_json(url, username, password, payload=None):
    headers = {
        "Authorization": basic_auth_header(username, password),
        "Accept": "application/json",
    }
    data = None
    if payload is not None:
        data = json.dumps(payload).encode("utf-8")
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(
        url,
        data=data,
        headers=headers,
        method="POST" if payload is not None else "GET",
    )
    try:
        with open_request(request) as response:
            return json.load(response)
    except json.JSONDecodeError as error:
        raise JmapxError(f"服务器响应不是合法 JSON: {error}") from error


def http_open(url, username, password, extra_headers=None):
    headers = {
        "Authorization": basic_auth_header(username, password),
        "Accept": "application/octet-stream",
    }
    headers.update(extra_headers or {})
    return open_request(urllib.request.Request(url, headers=headers))


def create_context(args):
    credentials, source = resolve_credentials(args.creds_file)
    if args.debug:
        print(f"[凭据来源] {source}", file=sys.stderr)

    server = normalize_server(credentials["server"])
    session = http_json(
        f"{server}/.well-known/jmap",
        credentials["username"],
        credentials["password"],
    )
    debug_log(args.debug, f"服务器: {server}")
    debug_log(args.debug, f"Session: {session.get('apiUrl')}")

    accounts = session.get("accounts") or {}
    if not accounts:
        fail("Session 未返回任何可用账户")
    account_id = (session.get("primaryAccounts") or {}).get(MAIL_CAPABILITY)
    if account_id not in accounts:
        account_id = next(iter(accounts))
    account = accounts.get(account_id, {})
    debug_log(args.debug, f"账户: {account.get('name')} (id={account_id})")

    core = (session.get("capabilities") or {}).get(CORE_CAPABILITY, {})
    return JmapContext(
        username=credentials["username"],
        password=credentials["password"],
        session=session,
        account_id=account_id,
        api_url=session["apiUrl"],
        max_objects=core.get("maxObjectsInGet") or DEFAULT_MAX_OBJECTS,
        max_calls=core.get("maxCallsInRequest") or DEFAULT_MAX_CALLS,
        debug=args.debug,
    )


def jmap_post(context, method_calls, using=USING):
    result = http_json(
        context.api_url,
        context.username,
        context.password,
        {"using": using, "methodCalls": method_calls},
    )
    return result.get("methodResponses", [])


def method_response(responses, method_name, error_message):
    response = next((arguments for name, arguments, _ in responses if name == method_name), None)
    if response is None:
        fail(f"{error_message}: {compact_json(responses)[:300]}")
    return response


def query_all_email_ids(context, query_filter=None):
    ids = []
    total = None
    position = 0

    while True:
        arguments = {
            "accountId": context.account_id,
            "sort": [{"property": "receivedAt", "isAscending": False}],
            "position": position,
            "limit": QUERY_PAGE_SIZE,
            "calculateTotal": total is None,
        }
        if query_filter:
            arguments["filter"] = query_filter

        response = method_response(
            jmap_post(context, [["Email/query", arguments, "q"]]),
            "Email/query",
            "Email/query 失败",
        )
        page_ids = response.get("ids") or []
        if total is None:
            total = response.get("total")
        ids.extend(page_ids)

        limit = response.get("limit", QUERY_PAGE_SIZE)
        if not page_ids or len(page_ids) < limit:
            break
        position += len(page_ids)
        if total is not None and len(ids) >= total:
            break

    return ids, total


def chunked(items, size):
    return [items[index:index + size] for index in range(0, len(items), size)]


def fetch_emails_batched(
    context,
    ids,
    properties=None,
    body_options=None,
):
    """批量 Email/get；requestTooLarge 时自动拆半重试。"""
    properties = properties or EMAIL_PROPERTIES
    body_options = body_options or {}
    original_batches = chunked(ids, context.max_objects)
    pending = list(original_batches)
    emails = []
    not_found = []
    request_count = 0

    while pending:
        group = pending[:context.max_calls]
        request_count += 1
        calls = []
        call_batches = {}
        for index, batch in enumerate(group):
            call_id = f"g{index}"
            arguments = {
                "accountId": context.account_id,
                "ids": batch,
                "properties": properties,
                **body_options,
            }
            calls.append(["Email/get", arguments, call_id])
            call_batches[call_id] = batch

        responses = jmap_post(context, calls)
        retry_batches = []
        responded = set()
        for name, arguments, call_id in responses:
            batch = call_batches.get(call_id)
            if batch is None:
                fail(f"Email/get 返回未知调用 id: {call_id}")
            responded.add(call_id)
            if name == "Email/get":
                emails.extend(arguments.get("list", []))
                not_found.extend(arguments.get("notFound", []))
            elif name == "error" and arguments.get("type") == "requestTooLarge":
                if len(batch) <= 1:
                    fail("单个 id 的 Email/get 仍被拒绝（requestTooLarge），服务器限制异常")
                middle = len(batch) // 2
                retry_batches.extend([batch[:middle], batch[middle:]])
            else:
                fail(f"Email/get 失败: {compact_json((name, arguments))[:300]}")

        missing = set(call_batches) - responded
        if missing:
            fail(f"Email/get 缺少调用响应: {', '.join(sorted(missing))}")
        pending = pending[len(group):] + retry_batches

    debug_log(
        context.debug,
        f"Email/get: {len(original_batches)} 批, {request_count} 个 HTTP 请求",
    )
    return emails, not_found


def fetch_mailboxes(context):
    responses = jmap_post(context, [[
        "Mailbox/get",
        {
            "accountId": context.account_id,
            "ids": None,
            "properties": MAILBOX_PROPERTIES,
        },
        "m",
    ]])
    if responses and responses[0][0] == "Mailbox/get":
        return responses[0][1].get("list", [])

    if not responses or responses[0][0] != "error" \
            or responses[0][1].get("type") != "requestTooLarge":
        fail(f"Mailbox/get 失败: {compact_json(responses)[:300]}")

    query = method_response(
        jmap_post(context, [[
            "Mailbox/query",
            {"accountId": context.account_id, "limit": None},
            "mq",
        ]]),
        "Mailbox/query",
        "Mailbox/query 失败",
    )
    mailboxes = []
    for batch in chunked(query.get("ids") or [], context.max_objects):
        response = method_response(
            jmap_post(context, [[
                "Mailbox/get",
                {
                    "accountId": context.account_id,
                    "ids": batch,
                    "properties": MAILBOX_PROPERTIES,
                },
                "m",
            ]]),
            "Mailbox/get",
            "Mailbox/get 分批拉取失败",
        )
        mailboxes.extend(response.get("list", []))
    return mailboxes


def attachment_matches(name, pattern):
    return fnmatch.fnmatch(name.lower(), pattern.lower())


def parse_attachment_filter(value):
    if value is None:
        return None, False
    invert = value.startswith("!")
    pattern = value[1:] if invert else value
    if not pattern:
        fail("--filter 为空（! 前缀后需跟匹配模式）")
    return pattern, invert


def attachment_view(attachment):
    return {
        "partId": attachment.get("partId"),
        "name": attachment.get("name"),
        "type": attachment.get("type"),
        "size": attachment.get("size"),
        "blobId": attachment.get("blobId"),
    }


def partition_attachments(email, pattern, invert):
    matched, unmatched = [], []
    for attachment in email.get("attachments") or []:
        name = attachment.get("name") or ""
        hit = attachment_matches(name, pattern) != invert if pattern is not None else True
        (matched if hit else unmatched).append(attachment_view(attachment))
    return {
        "id": email["id"],
        "subject": email.get("subject"),
        "from": email.get("from"),
        "to": email.get("to"),
        "matched": matched,
        "unmatched": unmatched,
    }


def require_directory(path):
    absolute = os.path.abspath(path)
    if not os.path.isdir(absolute):
        fail(f"目标目录不存在: {path}（不会自动创建）")
    return absolute


def fit_conflict_name(stem, extension, number, blob_id, name_max):
    """重名候选超限时优先截 blobId，再截原名。"""
    blob_part = blob_id
    while True:
        candidate = f"{stem}-{number}-{blob_part}{extension}"
        if len(candidate.encode("utf-8")) <= name_max:
            return candidate
        if blob_part:
            blob_part = blob_part[:-1]
        elif stem:
            stem = stem[:-1]
        else:
            return f"-{number}{extension}"


def unique_dest_path(dest_dir, name, blob_id):
    path = os.path.join(dest_dir, name)
    if not os.path.exists(path):
        return path, False

    try:
        name_max = os.pathconf(dest_dir, "PC_NAME_MAX")
    except (OSError, ValueError):
        name_max = 255
    stem, extension = os.path.splitext(name)
    number = 1
    while True:
        candidate = fit_conflict_name(stem, extension, number, blob_id, name_max)
        candidate_path = os.path.join(dest_dir, candidate)
        if not os.path.exists(candidate_path):
            return candidate_path, True
        number += 1


def fetch_range_to_file(context, url, start, end, part_path):
    with http_open(
        url,
        context.username,
        context.password,
        {"Range": f"bytes={start}-{end}"},
    ) as response, open(part_path, "wb") as file:
        if response.status != 206:
            raise JmapxError(f"Range 下载未返回 HTTP 206: {response.status}")
        shutil.copyfileobj(response, file, COPY_BUFFER_SIZE)


def merge_parts(part_paths, output_path):
    with open(output_path, "wb") as output:
        for part_path in part_paths:
            with open(part_path, "rb") as part:
                shutil.copyfileobj(part, output, COPY_BUFFER_SIZE)


def download_one_blob(context, blob_id, name, dest_dir, chunks):
    """下载单个 blob；Range 不可用时自动复用探测响应或回退单连接。"""
    safe_name = os.path.basename((name or blob_id).replace("\\", "/")) or blob_id
    if not context.download_url:
        raise JmapxError("Session 未提供 downloadUrl")
    url = context.download_url.format(
        accountId=context.account_id,
        blobId=blob_id,
        name=urllib.parse.quote(safe_name, safe=""),
        type="",
    )

    with tempfile.TemporaryDirectory(prefix=".jmapx-", dir=dest_dir) as work_dir:
        temp_path = os.path.join(work_dir, "download.tmp")
        total = None

        with http_open(
            url,
            context.username,
            context.password,
            {"Range": "bytes=0-0"},
        ) as probe:
            content_range = probe.headers.get("Content-Range") or ""
            if probe.status == 206:
                match = re.search(r"bytes 0-0/(\d+)", content_range)
                if match:
                    total = int(match.group(1))
            elif probe.status == 200:
                with open(temp_path, "wb") as file:
                    shutil.copyfileobj(probe, file, COPY_BUFFER_SIZE)
                total = os.path.getsize(temp_path)

        if not os.path.exists(temp_path):
            if total is None:
                debug_log(context.debug, f"{blob_id[:8]}… 服务器不支持 Range，单连接下载")
                with http_open(url, context.username, context.password) as response, \
                        open(temp_path, "wb") as file:
                    shutil.copyfileobj(response, file, COPY_BUFFER_SIZE)
            elif chunks > 1 and total > 0:
                step = (total + chunks - 1) // chunks
                ranges = [
                    (start, min(start + step - 1, total - 1))
                    for start in range(0, total, step)
                ]
                part_paths = [
                    os.path.join(work_dir, f"part{index}")
                    for index in range(len(ranges))
                ]
                debug_log(
                    context.debug,
                    f"{blob_id[:8]}… {total} 字节, {len(ranges)} 段并发 Range 下载",
                )
                with ThreadPoolExecutor(max_workers=len(ranges)) as pool:
                    futures = [
                        pool.submit(
                            fetch_range_to_file,
                            context,
                            url,
                            start,
                            end,
                            part_path,
                        )
                        for (start, end), part_path in zip(ranges, part_paths)
                    ]
                    for future in futures:
                        future.result()
                merge_parts(part_paths, temp_path)
            else:
                with http_open(url, context.username, context.password) as response, \
                        open(temp_path, "wb") as file:
                    shutil.copyfileobj(response, file, COPY_BUFFER_SIZE)

        # 检查和原子替换必须处于同一锁内，避免并发同名文件相互覆盖。
        with _DESTINATION_LOCK:
            final_path, renamed = unique_dest_path(dest_dir, safe_name, blob_id)
            os.replace(temp_path, final_path)
        return {
            "blobId": blob_id,
            "file": final_path,
            "size": os.path.getsize(final_path),
            "renamed": renamed,
        }


def download_many(context, jobs, dest_dir, concurrency, chunks):
    """并发下载多个 (blobId, name)，保持输入顺序返回结果。"""
    downloaded, failed = [], []
    if not jobs:
        return downloaded, failed

    with ThreadPoolExecutor(max_workers=concurrency) as pool:
        submitted = [
            (
                blob_id,
                pool.submit(
                    download_one_blob,
                    context,
                    blob_id,
                    name,
                    dest_dir,
                    chunks,
                ),
            )
            for blob_id, name in jobs
        ]
        for blob_id, future in submitted:
            try:
                downloaded.append(future.result())
            except Exception as error:  # 单文件失败不影响其他下载任务
                failed.append({"blobId": blob_id, "error": str(error)})
    return downloaded, failed


def finish_download_output(output, failed, pretty):
    print_json(output, pretty)
    if failed:
        print(f"警告: {len(failed)} 个附件下载失败", file=sys.stderr)
        return 1
    return 0


def cmd_total(args):
    context = create_context(args)
    response = method_response(
        jmap_post(context, [[
            "Email/query",
            {"accountId": context.account_id, "limit": 1, "calculateTotal": True},
            "q1",
        ]]),
        "Email/query",
        "响应中未找到 Email/query 结果",
    )
    print_json({"total": response.get("total")}, args.pretty)


def cmd_emails(args):
    context = create_context(args)
    server_filter = {}
    if args.start:
        server_filter["after"] = parse_datetime_arg(args.start, False, "--start")
    if args.end:
        server_filter["before"] = parse_datetime_arg(args.end, True, "--end")
    sender = parse_query_addr(args.from_) if args.from_ else None
    recipient = parse_query_addr(args.to) if args.to else None
    if server_filter:
        debug_log(context.debug, f"服务端日期过滤: {compact_json(server_filter)}")

    ids, total = query_all_email_ids(context, server_filter or None)
    debug_log(context.debug, f"Email/query: 共 {len(ids)} 个 id, total={total}")
    emails, not_found = fetch_emails_batched(context, ids)

    if sender:
        emails = [email for email in emails if email_matches(email, "from", sender)]
    if recipient:
        emails = [email for email in emails if email_matches(email, "to", recipient)]
    if sender or recipient:
        debug_log(context.debug, f"客户端精确过滤后: {len(emails)} 封")

    emails.sort(
        key=lambda email: (email.get("receivedAt") or "", email.get("id") or ""),
        reverse=True,
    )
    output = {
        "accountId": context.account_id,
        "total": total,
        "returned": len(emails),
        "notFound": not_found,
        "mailboxes": fetch_mailboxes(context),
        "emails": emails,
    }
    applied = {
        key: value
        for key, value in (
            ("from", args.from_),
            ("to", args.to),
            ("start", args.start),
            ("end", args.end),
        )
        if value
    }
    if applied:
        output["filter"] = applied
    print_json(output, args.pretty)


def cmd_detail(args):
    context = create_context(args)
    ids = parse_ids(args.ids, context.debug, report_duplicates=True)
    emails, not_found = fetch_emails_batched(
        context,
        ids,
        properties=DETAIL_PROPERTIES,
        body_options={
            "fetchTextBodyValues": True,
            "fetchHTMLBodyValues": True,
            "maxBodyValueBytes": args.body_max_bytes,
        },
    )
    order = {email_id: index for index, email_id in enumerate(ids)}
    emails.sort(key=lambda email: order.get(email.get("id"), 10 ** 9))
    print_json(
        {
            "accountId": context.account_id,
            "requested": len(ids),
            "returned": len(emails),
            "notFound": not_found,
            "emails": emails,
        },
        args.pretty,
    )


def cmd_attachments(args):
    context = create_context(args)
    ids = parse_ids(args.ids)
    pattern, invert = parse_attachment_filter(args.filter)
    emails, not_found = fetch_emails_batched(
        context,
        ids,
        properties=ATTACHMENT_PROPERTIES,
    )
    order = {email_id: index for index, email_id in enumerate(ids)}
    emails.sort(key=lambda email: order.get(email.get("id"), 10 ** 9))
    result_emails = [partition_attachments(email, pattern, invert) for email in emails]

    output = {
        "accountId": context.account_id,
        "requested": len(ids),
        "notFound": not_found,
        "emails": result_emails,
    }
    if args.filter is not None:
        output["filter"] = args.filter

    failed = []
    if args.download_dir:
        dest_dir = require_directory(args.download_dir)
        if not context.download_url:
            fail("Session 未提供 downloadUrl")
        jobs = unique_jobs_by_blob_id([
            (attachment["blobId"], attachment.get("name"))
            for email in result_emails
            for attachment in email["matched"]
            if attachment.get("blobId")
        ])
        debug_log(
            context.debug,
            f"下载 {len(jobs)} 个命中附件到 {dest_dir} | "
            f"并发: {args.concurrency} | 分块: {args.chunks}",
        )
        downloaded, failed = download_many(
            context,
            jobs,
            dest_dir,
            args.concurrency,
            args.chunks,
        )
        output["download"] = {
            "dir": dest_dir,
            "requested": len(jobs),
            "downloaded": downloaded,
            "failed": failed,
        }

    return finish_download_output(output, failed, args.pretty)


def cmd_download(args):
    context = create_context(args)
    dest_dir = require_directory(args.dir)
    blob_ids = split_csv(args.blob_ids)
    if not blob_ids:
        fail("--blob-ids 不能为空")
    names = None
    if args.names:
        names = split_csv(args.names)
        if len(names) != len(blob_ids):
            fail(f"--names 数量({len(names)})与 --blob-ids 数量({len(blob_ids)})不一致")
    if not context.download_url:
        fail("Session 未提供 downloadUrl")

    debug_log(
        context.debug,
        f"目标目录: {dest_dir} | 并发文件数: {args.concurrency} | 每文件分块: {args.chunks}",
    )
    jobs = [
        (blob_id, names[index] if names else None)
        for index, blob_id in enumerate(blob_ids)
    ]
    downloaded, failed = download_many(
        context,
        jobs,
        dest_dir,
        args.concurrency,
        args.chunks,
    )
    return finish_download_output(
        {
            "dir": dest_dir,
            "requested": len(blob_ids),
            "downloaded": downloaded,
            "failed": failed,
        },
        failed,
        args.pretty,
    )


def add_transfer_options(parser):
    parser.add_argument(
        "--concurrency",
        type=int,
        default=16,
        metavar="N",
        help="下载并发文件数（默认 16）",
    )
    parser.add_argument(
        "--chunks",
        type=int,
        default=4,
        metavar="N",
        help="每文件 Range 分块数（默认 4，服务器不支持时自动回退单连接）",
    )


def build_parser():
    parser = argparse.ArgumentParser(prog="jmapx", description="JMAP 客户端工具")
    parser.add_argument(
        "--creds-file",
        metavar="PATH",
        help=f"身份配置文件路径（默认: 脚本同目录下的 {DEFAULT_CREDS_FILE}）",
    )
    parser.add_argument(
        "--debug",
        action="store_true",
        help="开启调试模式，输出凭据来源等诊断信息（默认关闭）",
    )
    parser.add_argument(
        "--pretty",
        action="store_true",
        help="格式化输出 JSON（4 个空格缩进），默认紧凑格式",
    )
    subparsers = parser.add_subparsers(dest="command", metavar="COMMAND")

    total = subparsers.add_parser("total", help="获取邮件总数（含垃圾箱）")
    total.set_defaults(func=cmd_total)

    emails = subparsers.add_parser(
        "emails",
        help="列出所有邮件（含垃圾箱），JSON 返回；支持日期/发件人/收件人过滤",
        description=(
            "列出所有邮件（含垃圾箱），JSON 返回。"
            "日期过滤在服务端执行（精确到秒）；发件人/收件人为客户端精确匹配"
            "（JMAP 协议的 from/to 为包含式搜索，无法保证精确）。"
            "结束时间不含边界时刻（before 语义）；--end 仅给日期时视为含当天全天。"
        ),
    )
    emails.add_argument(
        "--from",
        dest="from_",
        metavar="TEXT",
        help='发件人精确匹配：邮箱地址（不区分大小写）或显示名；支持 "Name <email>" 格式',
    )
    emails.add_argument("--to", metavar="TEXT", help="收件人精确匹配，规则同 --from")
    emails.add_argument(
        "--start",
        metavar="DT",
        help=(
            "开始时间（含）。YYYY-MM-DD（当日 00:00:00）或 "
            "YYYY-MM-DDTHH:MM:SS（精确到秒），可带时区 Z/±HH:MM，缺省按本地时区"
        ),
    )
    emails.add_argument(
        "--end",
        metavar="DT",
        help=(
            "结束时间（不含）。YYYY-MM-DD（视为次日 00:00:00，即含当天全天）或 "
            "YYYY-MM-DDTHH:MM:SS（精确到秒）"
        ),
    )
    emails.set_defaults(func=cmd_emails)

    detail = subparsers.add_parser(
        "detail",
        help="按 ids 查询邮件详细信息（含正文、附件列表），JSON 返回",
        description=(
            "按 ids 列表查询邮件详细信息（主题/发件人/时间/正文/附件列表），JSON 返回。"
            "批量策略：≤maxObjectsInGet 单调用；≤maxCallsInRequest×maxObjectsInGet "
            "单请求多调用；更多则串行多个 HTTP 请求（无并发）。"
        ),
    )
    detail.add_argument(
        "--ids",
        metavar="LIST",
        required=True,
        help='逗号分隔的邮件 id 列表，如 "id1,id2,id3"',
    )
    detail.add_argument(
        "--body-max-bytes",
        type=int,
        metavar="N",
        default=10000,
        help="正文内容截断字节数，0 表示不截断（默认 10000）",
    )
    detail.set_defaults(func=cmd_detail)

    download = subparsers.add_parser(
        "download",
        help="按 blobId 下载附件到指定目录（多文件并发 + Range 分块）",
        description=(
            "按 blobId 下载附件到指定目录。--dir 必须已存在（不会自动创建）。"
            "文件重名时自动重命名（原名-N-完整blobId），绝不覆盖。"
            "多文件并发下载，每个文件按 Range 分块并行拉取（服务器不支持时自动回退单连接）。"
        ),
    )
    download.add_argument("--blob-ids", metavar="LIST", required=True, help="逗号分隔的 blobId 列表")
    download.add_argument("--dir", metavar="PATH", required=True, help="目标目录（必须已存在，不会自动创建）")
    download.add_argument(
        "--names",
        metavar="LIST",
        help="可选：与 --blob-ids 一一对应的文件名列表（缺省用 blobId 命名）",
    )
    add_transfer_options(download)
    download.set_defaults(func=cmd_download)

    attachments = subparsers.add_parser(
        "attachments",
        help="按 ids 查邮件附件列表，支持名称过滤分组，JSON 返回",
        description=(
            "按 ids 列表查询邮件的附件列表（名称/类型/大小/blobId），JSON 返回。"
            "--filter 按 glob 语法过滤附件名（不区分大小写），! 前缀反向；"
            "无论是否命中都会返回，分 matched/unmatched 两组。"
        ),
    )
    attachments.add_argument("--ids", metavar="LIST", required=True, help="逗号分隔的邮件 id 列表")
    attachments.add_argument(
        "--filter",
        metavar="GLOB",
        help='附件名 glob 过滤，如 "*.pdf"；"!*.pdf" 反向（不匹配的进 matched 组）',
    )
    attachments.add_argument(
        "--download-dir",
        metavar="PATH",
        help=(
            "提供时下载所有命中的附件（matched 组）到该目录："
            "必须已存在（不自动创建），按原始附件名命名，重名自动重命名，多并发下载"
        ),
    )
    add_transfer_options(attachments)
    attachments.set_defaults(func=cmd_attachments)
    return parser


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.command is None:
        parser.print_help()
        return 0
    try:
        return args.func(args) or 0
    except JmapxError as error:
        print(f"警告: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
